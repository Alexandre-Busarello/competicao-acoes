generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  authUserId   String        @unique
  name         String
  email        String?       @unique
  avatarUrl    String?
  isPremium    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subscription Subscription?
  transactions Transaction[]

  @@index([authUserId])
  @@index([email])
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  ticker    String
  type      String
  quantity  Decimal  @db.Decimal(18, 8)
  price     Decimal  @db.Decimal(10, 2)
  date      DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticker])
  @@index([date])
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique
  kiwifyId         String?   @unique
  kiwifyOrderId    String?   @unique
  status           String
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([kiwifyId])
  @@index([status])
  @@index([status, currentPeriodEnd])
}

model Lead {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String?
  source          String?
  checkoutStarted Boolean   @default(false)
  converted       Boolean   @default(false)
  convertedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([converted])
  @@index([checkoutStarted])
}

model BrunoPortfolio {
  id            String                @id @default(uuid())
  monthlyReturn Decimal               @db.Decimal(5, 2)
  annualReturn  Decimal?              @db.Decimal(5, 2)
  description   String?
  updatedAt     DateTime              @updatedAt
  assets        BrunoPortfolioAsset[]
}

model BrunoPortfolioAsset {
  id               String         @id @default(uuid())
  brunoPortfolioId String
  ticker           String
  name             String
  type             String
  quantity         Int
  averagePrice     Decimal        @db.Decimal(10, 2)
  currentPrice     Decimal        @db.Decimal(10, 2)
  returnPercentage Decimal        @db.Decimal(5, 2)
  brunoPortfolio   BrunoPortfolio @relation(fields: [brunoPortfolioId], references: [id], onDelete: Cascade)

  @@index([brunoPortfolioId])
  @@index([ticker])
}

model RankingCalculation {
  id                String   @id @default(uuid())
  period            String
  year              Int
  month             Int?
  rankingData       Json
  totalParticipants Int
  calculatedAt      DateTime @default(now())

  @@index([period, year, month, calculatedAt])
  @@index([period, calculatedAt])
  @@index([calculatedAt])
}

model PriceUpdateCheckpoint {
  id                    String   @id @default(uuid())
  status                String   // 'in_progress' | 'completed' | 'failed'
  phase                 String   // 'prices' | 'ranking'
  processedUserIds      String[] // IDs dos usuários já processados
  monthlyRankings       Json?    // Rankings mensais parciais
  annualRankings        Json?    // Rankings anuais parciais
  pricesLastUpdate      DateTime?
  startedAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  completedAt           DateTime?

  @@index([status])
  @@index([updatedAt])
}
