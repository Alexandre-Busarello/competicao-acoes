generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_DATABASE_URL")
}

model User {
  id                          String                       @id @default(uuid())
  authUserId                  String                       @unique
  name                        String
  email                       String?                      @unique
  avatarUrl                   String?
  slug                        String?                      @unique
  isPremium                   Boolean                      @default(false)
  pwaInstalledAt              DateTime?
  lastAccessAt                DateTime?
  notificationVariationIndex  Int                          @default(0)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  subscription                Subscription?
  transactions                Transaction[]
  perpetualProfitability      UserPerpetualProfitability?
  feedPosts                   FeedPost[]
  feedComments                FeedComment[]
  feedLikes                   FeedLike[]
  followers                   UserFollow[]                 @relation("Follower")
  following                   UserFollow[]                 @relation("Following")
  blocker                     UserBlock[]                  @relation("Blocker")
  blocked                     UserBlock[]                  @relation("Blocked")
  notifications               Notification[]
  notificationsAsActor        Notification[]               @relation("NotificationActor")
  medals                      UserMedal[]
  stats                       UserStats?
  timeline                    FeedTimeline[]
  feedViews                   FeedView[]
  pollVotes                   FeedPollVote[]
  pushSubscriptions           PushSubscription[]
  pushNotificationLogs        PushNotificationLog[]
  pushNotificationPreferences PushNotificationPreferences?
  rankingHistory              UserRankingHistory[]
  bannerClicks                FeedBannerClick[]
  bannerConversions           FeedBannerConversion[]
  conversionEvents            ConversionEvent[]

  @@index([authUserId])
  @@index([email])
  @@index([slug])
}

model Transaction {
  id        String    @id @default(uuid())
  userId    String
  ticker    String
  type      String
  quantity  Decimal   @db.Decimal(18, 8)
  price     Decimal   @db.Decimal(10, 2)
  currency  String? // Moeda do ativo (BRL, USD, EUR, etc.) obtida do Yahoo Finance
  date      DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedPost  FeedPost?

  @@index([userId])
  @@index([ticker])
  @@index([date])
  @@index([currency])
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique
  kiwifyId         String?   @unique
  kiwifyOrderId    String?   @unique
  status           String
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([kiwifyId])
  @@index([status])
  @@index([status, currentPeriodEnd])
}

model Lead {
  id              String                  @id @default(uuid())
  email           String                  @unique
  name            String?
  source          String?
  checkoutStarted Boolean                 @default(false)
  converted       Boolean                 @default(false)
  convertedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  bannerClickId  String?                 @unique
  bannerClick     FeedBannerClick?        @relation("LeadBannerClick")
  bannerConversions FeedBannerConversion[]
  conversionEvents ConversionEvent[]

  @@index([email])
  @@index([converted])
  @@index([checkoutStarted])
}

model BrunoPortfolio {
  id            String                @id @default(uuid())
  monthlyReturn Decimal               @db.Decimal(5, 2)
  annualReturn  Decimal?              @db.Decimal(5, 2)
  description   String?
  updatedAt     DateTime              @updatedAt
  assets        BrunoPortfolioAsset[]
}

model BrunoPortfolioAsset {
  id               String         @id @default(uuid())
  brunoPortfolioId String
  ticker           String
  name             String
  type             String
  quantity         Int
  averagePrice     Decimal        @db.Decimal(10, 2)
  currentPrice     Decimal        @db.Decimal(10, 2)
  returnPercentage Decimal        @db.Decimal(5, 2)
  brunoPortfolio   BrunoPortfolio @relation(fields: [brunoPortfolioId], references: [id], onDelete: Cascade)

  @@index([brunoPortfolioId])
  @@index([ticker])
}

model RankingCalculation {
  id                String   @id @default(uuid())
  period            String
  year              Int
  month             Int?
  rankingData       Json
  totalParticipants Int
  calculatedAt      DateTime @default(now())

  @@index([period, year, month, calculatedAt])
  @@index([period, calculatedAt])
  @@index([calculatedAt])
}

model PriceUpdateCheckpoint {
  id               String    @id @default(uuid())
  status           String // 'in_progress' | 'completed' | 'failed'
  phase            String // 'prices' | 'ranking'
  processedUserIds String[] // IDs dos usuários já processados
  monthlyRankings  Json? // Rankings mensais parciais
  annualRankings   Json? // Rankings anuais parciais
  pricesLastUpdate DateTime?
  startedAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?

  @@index([status])
  @@index([updatedAt])
}

model UserPerpetualProfitability {
  id            String   @id @default(uuid())
  userId        String   @unique
  profitability Decimal  @db.Decimal(10, 2)
  totalInvested Decimal  @db.Decimal(18, 2)
  currentValue  Decimal  @db.Decimal(18, 2)
  calculatedAt  DateTime @default(now())
  lastUpdated   DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastUpdated])
}

model FeedPost {
  id            String         @id @default(uuid())
  userId        String
  transactionId String?        @unique
  slug          String         @unique
  content       String
  type          String         @default("transaction") // 'transaction' | 'custom' | 'share'
  metadata      Json?
  isPublic      Boolean        @default(true)
  likeCount     Int            @default(0)
  commentCount  Int            @default(0)
  shareCount    Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  reportedAt    DateTime?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  comments      FeedComment[]
  likes         FeedLike[]
  notifications Notification[]
  timeline      FeedTimeline[]
  views         FeedView[]
  poll          FeedPoll?

  @@index([userId])
  @@index([slug])
  @@index([createdAt(sort: Desc)])
  @@index([transactionId])
  @@index([isPublic])
  @@index([userId, createdAt(sort: Desc)])
}

model FeedComment {
  id              String         @id @default(uuid())
  postId          String
  userId          String
  parentCommentId String?
  content         String
  likeCount       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  reportedAt      DateTime?
  post            FeedPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment   FeedComment?   @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         FeedComment[]  @relation("CommentReplies")
  notifications   Notification[]

  @@index([postId])
  @@index([userId])
  @@index([parentCommentId])
  @@index([createdAt(sort: Desc)])
  @@index([postId, createdAt(sort: Desc)])
}

model FeedLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model UserFollow {
  id                   String   @id @default(uuid())
  followerId           String
  followingId          String
  createdAt            DateTime @default(now())
  notificationsEnabled Boolean  @default(true)
  follower             User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following            User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([followingId, createdAt(sort: Desc)])
}

model UserStats {
  id                 String   @id @default(uuid())
  userId             String   @unique
  followerCount      Int      @default(0)
  followingCount     Int      @default(0)
  postCount          Int      @default(0)
  totalLikesReceived Int      @default(0)
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Notification {
  id        String       @id @default(uuid())
  userId    String
  type      String // 'like' | 'comment' | 'follow' | 'mention' | 'reply'
  actorId   String
  postId    String?
  commentId String?
  content   String?
  read      Boolean      @default(false)
  readAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor     User         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post      FeedPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   FeedComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt(sort: Desc)])
  @@index([userId, read, createdAt(sort: Desc)])
}

model FeedTimeline {
  id         String   @id @default(uuid())
  userId     String
  postId     String
  postUserId String
  score      Decimal? @db.Decimal(10, 2)
  createdAt  DateTime // Data do post original
  addedAt    DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, score(sort: Desc)])
  @@index([postId])
}

model FeedView {
  id       String   @id @default(uuid())
  userId   String
  postId   String
  viewedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post     FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, viewedAt(sort: Desc)])
  @@index([postId])
}

model UserMedal {
  id           String   @id @default(uuid())
  userId       String
  period       String // 'mensal' | 'anual'
  year         Int
  month        Int?
  position     Int // 1=ouro, 2=prata, 3=bronze
  medalType    String // 'gold' | 'silver' | 'bronze'
  calculatedAt DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([period, year, month])
  @@index([calculatedAt(sort: Desc)])
  @@index([userId, calculatedAt(sort: Desc)])
}

model MedalSettlement {
  id        String   @id @default(uuid())
  period    String // 'mensal' | 'anual'
  year      Int
  month     Int? // null para anual
  settledAt DateTime @default(now()) // Timestamp UTC do banco

  @@unique([period, year, month])
  @@index([period, year, month])
  @@index([settledAt])
}

model ActionQueue {
  id           String    @id @default(uuid())
  actionType   String // 'like' | 'comment' | 'follow' | 'unfollow' | 'notification' | 'timeline_update'
  payload      Json
  status       String    @default("pending") // 'pending' | 'processing' | 'completed' | 'failed'
  priority     Int       @default(0)
  retryCount   Int       @default(0)
  maxRetries   Int       @default(3)
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lockedAt     DateTime?
  lockedBy     String?

  @@index([status])
  @@index([status, priority(sort: Desc), createdAt(sort: Asc)])
  @@index([actionType])
  @@index([createdAt])
}

model KiwifyWebhookQueue {
  id               String    @id @default(uuid())
  webhookEventType String // 'order_approved' | 'order_refunded' | 'chargeback' | etc
  orderId          String? // order_id do Kiwify para facilitar busca
  customerEmail    String? // email do cliente para facilitar busca
  payload          Json // Body completo do webhook
  status           String    @default("pending") // 'pending' | 'processing' | 'completed' | 'error'
  errorMessage     String? // Mensagem de erro se status = 'error'
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([status, createdAt(sort: Asc)])
  @@index([webhookEventType])
  @@index([orderId])
  @@index([customerEmail])
  @@index([createdAt])
}

model FeedPoll {
  id         String         @id @default(uuid())
  postId     String         @unique
  question   String
  options    Json // Array de strings: ["opção1", "opção2", ...]
  totalVotes Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  post       FeedPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes      FeedPollVote[]

  @@index([postId])
}

model FeedPollVote {
  id          String   @id @default(uuid())
  pollId      String
  userId      String
  optionIndex Int // Índice da opção votada (0-5)
  createdAt   DateTime @default(now())
  poll        FeedPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  endpoint   String
  keys       Json // { p256dh: string, auth: string }
  deviceId   String?
  deviceName String   @default("Outro")
  deviceType String   @default("unknown") // "desktop" | "mobile" | "unknown"
  enabled    Boolean  @default(true)
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([endpoint])
  @@index([userId])
  @@index([endpoint])
  @@index([userId, deviceId])
}

model PushNotificationLog {
  id     String   @id @default(uuid())
  userId String
  type   String // 'ranking' | 'engagement' | 'following' | 'test'
  sentAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, sentAt(sort: Desc)])
  @@index([type])
}

model PushNotificationPreferences {
  id                 String   @id @default(uuid())
  userId             String   @unique
  rankingEnabled     Boolean  @default(true)
  engagementEnabled  Boolean  @default(true)
  followingEnabled   Boolean  @default(true)
  interactionsEnabled Boolean @default(true)
  allEnabled         Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserRankingHistory {
  id        String   @id @default(uuid())
  userId    String
  period    String // 'mensal' | 'anual'
  year      Int
  month     Int?
  position  Int
  updatedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, year, month])
  @@index([userId])
  @@index([userId, period, year, month])
  @@index([updatedAt])
}

model NotificationMessageVariation {
  id        String   @id @default(uuid())
  type      String // 'ranking_top3', 'ranking_up', 'ranking_down', 'engagement', 'following', 'reengagement'
  variation String // 'A', 'B', 'C', 'D', 'F'
  title     String
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, variation])
  @@index([type, isActive])
}

model FeedBanner {
  id          String                  @id @default(uuid())
  variation   String                  @unique // 'A', 'B', 'C', 'D', 'E'
  title       String
  description String
  benefit     String                  // Benefício focado neste banner
  ctaText     String
  isActive    Boolean                 @default(true)
  priority    Int                     @default(0) // Calculado dinamicamente
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  impressions FeedBannerImpression[]
  clicks      FeedBannerClick[]
  conversions FeedBannerConversion[]

  @@index([variation])
  @@index([isActive, priority(sort: Desc)])
}

model FeedBannerImpression {
  id        String     @id @default(uuid())
  bannerId  String
  userId    String?    // null se não logado
  viewedAt  DateTime   @default(now())
  banner    FeedBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@index([bannerId])
  @@index([userId])
  @@index([viewedAt])
}

model FeedBannerClick {
  id        String     @id @default(uuid())
  bannerId  String
  userId    String?    // null se não logado
  leadId    String?    @unique // ID do lead criado
  clickedAt DateTime   @default(now())
  banner    FeedBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  lead      Lead?      @relation("LeadBannerClick", fields: [leadId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bannerId])
  @@index([userId])
  @@index([leadId])
  @@index([clickedAt])
}

model FeedBannerConversion {
  id          String            @id @default(uuid())
  bannerId   String
  userId     String
  leadId     String
  convertedAt DateTime          @default(now())
  banner     FeedBanner        @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead       Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([bannerId])
  @@index([userId])
  @@index([leadId])
  @@index([convertedAt])
}

model ConversionEvent {
  id          String   @id @default(uuid())
  type        String   // 'blur_overlay' | 'profile_checkout' | 'signup_banner'
  userId      String?
  leadId      String?
  viewedAt    DateTime @default(now())
  clickedAt   DateTime?
  convertedAt DateTime?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([userId])
  @@index([leadId])
  @@index([viewedAt])
  @@index([clickedAt])
  @@index([convertedAt])
}
