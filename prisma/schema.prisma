generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_DATABASE_URL")
}

model User {
  id                          String                       @id @default(uuid())
  authUserId                  String                       @unique
  name                        String
  email                       String?                      @unique
  avatarUrl                   String?
  isPremium                   Boolean                      @default(false)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  slug                        String?                      @unique
  lastAccessAt                DateTime?
  notificationVariationIndex  Int                          @default(0)
  pwaInstalledAt              DateTime?
  conversionEvents            ConversionEvent[]
  bannerClicks                FeedBannerClick[]
  bannerConversions           FeedBannerConversion[]
  feedComments                FeedComment[]
  feedLikes                   FeedLike[]
  pollVotes                   FeedPollVote[]
  feedPosts                   FeedPost[]
  timeline                    FeedTimeline[]
  feedViews                   FeedView[]
  notificationsAsActor        Notification[]               @relation("NotificationActor")
  notifications               Notification[]
  pushNotificationLogs        PushNotificationLog[]
  pushNotificationPreferences PushNotificationPreferences?
  pushSubscriptions           PushSubscription[]
  subscription                Subscription?
  transactions                Transaction[]
  blocked                     UserBlock[]                  @relation("Blocked")
  blocker                     UserBlock[]                  @relation("Blocker")
  followers                   UserFollow[]                 @relation("Follower")
  following                   UserFollow[]                 @relation("Following")
  medals                      UserMedal[]
  perpetualProfitability      UserPerpetualProfitability?
  rankingHistory              UserRankingHistory[]
  stats                       UserStats?

  @@index([authUserId])
  @@index([email])
  @@index([slug])
}

model Transaction {
  id        String    @id @default(uuid())
  userId    String
  ticker    String
  type      String
  quantity  Decimal   @db.Decimal(18, 8)
  price     Decimal   @db.Decimal(10, 2)
  date      DateTime
  createdAt DateTime  @default(now())
  currency  String?
  feedPost  FeedPost?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticker])
  @@index([date])
  @@index([currency])
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique
  kiwifyId         String?   @unique
  kiwifyOrderId    String?   @unique
  status           String
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([kiwifyId])
  @@index([status])
  @@index([status, currentPeriodEnd])
}

model Lead {
  id                                                  String                 @id @default(uuid())
  email                                               String                 @unique
  name                                                String?
  source                                              String?
  checkoutStarted                                     Boolean                @default(false)
  converted                                           Boolean                @default(false)
  convertedAt                                         DateTime?
  createdAt                                           DateTime               @default(now())
  updatedAt                                           DateTime               @updatedAt
  bannerClickId                                       String?                @unique
  conversionEvents                                    ConversionEvent[]
  bannerClick                                         FeedBannerClick?       @relation("LeadBannerClick")
  bannerConversions                                   FeedBannerConversion[]
  FeedBannerClick_Lead_bannerClickIdToFeedBannerClick FeedBannerClick?       @relation("Lead_bannerClickIdToFeedBannerClick", fields: [bannerClickId], references: [id])

  @@index([email])
  @@index([converted])
  @@index([checkoutStarted])
}

model BrunoPortfolio {
  id            String                @id @default(uuid())
  monthlyReturn Decimal               @db.Decimal(5, 2)
  annualReturn  Decimal?              @db.Decimal(5, 2)
  description   String?
  updatedAt     DateTime              @updatedAt
  assets        BrunoPortfolioAsset[]
}

model BrunoPortfolioAsset {
  id               String         @id @default(uuid())
  brunoPortfolioId String
  ticker           String
  name             String
  type             String
  quantity         Int
  averagePrice     Decimal        @db.Decimal(10, 2)
  currentPrice     Decimal        @db.Decimal(10, 2)
  returnPercentage Decimal        @db.Decimal(5, 2)
  brunoPortfolio   BrunoPortfolio @relation(fields: [brunoPortfolioId], references: [id], onDelete: Cascade)

  @@index([brunoPortfolioId])
  @@index([ticker])
}

model RankingCalculation {
  id                String   @id @default(uuid())
  period            String
  rankingData       Json
  totalParticipants Int
  calculatedAt      DateTime @default(now())
  month             Int?
  year              Int

  @@index([period, year, month, calculatedAt])
  @@index([period, calculatedAt])
  @@index([calculatedAt])
}

model PriceUpdateCheckpoint {
  id               String    @id @default(uuid())
  status           String
  phase            String
  processedUserIds String[]
  monthlyRankings  Json?
  annualRankings   Json?
  pricesLastUpdate DateTime?
  startedAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?

  @@index([status])
  @@index([updatedAt])
}

model UserPerpetualProfitability {
  id            String   @id @default(uuid())
  userId        String   @unique
  profitability Decimal  @db.Decimal(10, 2)
  totalInvested Decimal  @db.Decimal(18, 2)
  currentValue  Decimal  @db.Decimal(18, 2)
  calculatedAt  DateTime @default(now())
  lastUpdated   DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastUpdated])
}

model FeedPost {
  id            String         @id @default(uuid())
  userId        String
  transactionId String?        @unique
  slug          String         @unique
  content       String
  type          String         @default("transaction")
  metadata      Json?
  isPublic      Boolean        @default(true)
  likeCount     Int            @default(0)
  commentCount  Int            @default(0)
  shareCount    Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  reportedAt    DateTime?
  comments      FeedComment[]
  likes         FeedLike[]
  poll          FeedPoll?
  transaction   Transaction?   @relation(fields: [transactionId], references: [id])
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeline      FeedTimeline[]
  views         FeedView[]
  notifications Notification[]

  @@index([userId])
  @@index([slug])
  @@index([createdAt(sort: Desc)])
  @@index([transactionId])
  @@index([isPublic])
  @@index([userId, createdAt(sort: Desc)])
}

model FeedComment {
  id              String         @id @default(uuid())
  postId          String
  userId          String
  parentCommentId String?
  content         String
  likeCount       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  reportedAt      DateTime?
  parentComment   FeedComment?   @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         FeedComment[]  @relation("CommentReplies")
  post            FeedPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications   Notification[]

  @@index([postId])
  @@index([userId])
  @@index([parentCommentId])
  @@index([createdAt(sort: Desc)])
  @@index([postId, createdAt(sort: Desc)])
}

model FeedLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model UserFollow {
  id                   String   @id @default(uuid())
  followerId           String
  followingId          String
  createdAt            DateTime @default(now())
  notificationsEnabled Boolean  @default(true)
  follower             User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following            User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([followingId, createdAt(sort: Desc)])
}

model UserStats {
  id                 String   @id @default(uuid())
  userId             String   @unique
  followerCount      Int      @default(0)
  followingCount     Int      @default(0)
  postCount          Int      @default(0)
  totalLikesReceived Int      @default(0)
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Notification {
  id        String       @id @default(uuid())
  userId    String
  type      String
  actorId   String
  postId    String?
  commentId String?
  content   String?
  read      Boolean      @default(false)
  readAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  actor     User         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  comment   FeedComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post      FeedPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt(sort: Desc)])
  @@index([userId, read, createdAt(sort: Desc)])
}

model FeedTimeline {
  id         String   @id @default(uuid())
  userId     String
  postId     String
  postUserId String
  score      Decimal? @db.Decimal(10, 2)
  createdAt  DateTime
  addedAt    DateTime @default(now())
  post       FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, score(sort: Desc)])
  @@index([postId])
}

model FeedView {
  id       String   @id @default(uuid())
  userId   String
  postId   String
  viewedAt DateTime @default(now())
  post     FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, viewedAt(sort: Desc)])
  @@index([postId])
}

model UserMedal {
  id           String   @id @default(uuid())
  userId       String
  period       String
  year         Int
  month        Int?
  position     Int
  medalType    String
  calculatedAt DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([period, year, month])
  @@index([calculatedAt(sort: Desc)])
  @@index([userId, calculatedAt(sort: Desc)])
}

model MedalSettlement {
  id        String   @id @default(uuid())
  period    String
  year      Int
  month     Int?
  settledAt DateTime @default(now())

  @@unique([period, year, month])
  @@index([period, year, month])
  @@index([settledAt])
}

model ActionQueue {
  id           String    @id @default(uuid())
  actionType   String
  payload      Json
  status       String    @default("pending")
  priority     Int       @default(0)
  retryCount   Int       @default(0)
  maxRetries   Int       @default(3)
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lockedAt     DateTime?
  lockedBy     String?

  @@index([status])
  @@index([status, priority(sort: Desc), createdAt])
  @@index([actionType])
  @@index([createdAt])
}

model KiwifyWebhookQueue {
  id               String    @id @default(uuid())
  webhookEventType String
  orderId          String?
  customerEmail    String?
  payload          Json
  status           String    @default("pending")
  errorMessage     String?
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([status, createdAt])
  @@index([webhookEventType])
  @@index([orderId])
  @@index([customerEmail])
  @@index([createdAt])
}

model FeedPoll {
  id         String         @id @default(uuid())
  postId     String         @unique
  question   String
  options    Json
  totalVotes Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  post       FeedPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes      FeedPollVote[]

  @@index([postId])
}

model FeedPollVote {
  id          String   @id @default(uuid())
  pollId      String
  userId      String
  optionIndex Int
  createdAt   DateTime @default(now())
  poll        FeedPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  endpoint   String   @unique
  keys       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deviceId   String?
  deviceName String   @default("Outro")
  deviceType String   @default("unknown")
  enabled    Boolean  @default(true)
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([endpoint])
  @@index([userId, deviceId])
}

model PushNotificationLog {
  id     String   @id @default(uuid())
  userId String
  type   String
  sentAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, sentAt(sort: Desc)])
  @@index([type])
}

model PushNotificationPreferences {
  id                  String   @id @default(uuid())
  userId              String   @unique
  rankingEnabled      Boolean  @default(true)
  engagementEnabled   Boolean  @default(true)
  followingEnabled    Boolean  @default(true)
  allEnabled          Boolean  @default(true)
  updatedAt           DateTime @updatedAt
  interactionsEnabled Boolean  @default(true)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserRankingHistory {
  id        String   @id @default(uuid())
  userId    String
  period    String
  year      Int
  month     Int?
  position  Int
  updatedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, year, month])
  @@index([userId])
  @@index([userId, period, year, month])
  @@index([updatedAt])
}

model NotificationMessageVariation {
  id        String   @id @default(uuid())
  type      String
  variation String
  title     String
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, variation])
  @@index([type, isActive])
}

model FeedBanner {
  id          String                 @id @default(uuid())
  variation   String                 @unique
  title       String
  description String
  benefit     String
  ctaText     String
  isActive    Boolean                @default(true)
  priority    Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  clicks      FeedBannerClick[]
  conversions FeedBannerConversion[]
  impressions FeedBannerImpression[]

  @@index([variation])
  @@index([isActive, priority(sort: Desc)])
}

model FeedBannerImpression {
  id       String     @id @default(uuid())
  bannerId String
  userId   String?
  viewedAt DateTime   @default(now())
  banner   FeedBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@index([bannerId])
  @@index([userId])
  @@index([viewedAt])
}

model FeedBannerClick {
  id                                       String     @id @default(uuid())
  bannerId                                 String
  userId                                   String?
  leadId                                   String?    @unique
  clickedAt                                DateTime   @default(now())
  banner                                   FeedBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  lead                                     Lead?      @relation("LeadBannerClick", fields: [leadId], references: [id])
  user                                     User?      @relation(fields: [userId], references: [id])
  Lead_Lead_bannerClickIdToFeedBannerClick Lead?      @relation("Lead_bannerClickIdToFeedBannerClick")

  @@index([bannerId])
  @@index([userId])
  @@index([leadId])
  @@index([clickedAt])
}

model FeedBannerConversion {
  id          String     @id @default(uuid())
  bannerId    String
  userId      String
  leadId      String
  convertedAt DateTime   @default(now())
  banner      FeedBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bannerId])
  @@index([userId])
  @@index([leadId])
  @@index([convertedAt])
}

model ConversionEvent {
  id          String    @id @default(uuid())
  type        String
  userId      String?
  leadId      String?
  viewedAt    DateTime  @default(now())
  clickedAt   DateTime?
  convertedAt DateTime?
  lead        Lead?     @relation(fields: [leadId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([userId])
  @@index([leadId])
  @@index([viewedAt])
  @@index([clickedAt])
  @@index([convertedAt])
}

model GGBRanking {
  ticker          String   @id
  companyName     String?
  sector          String?
  industry        String?
  financialData   Json
  greenblattScore Decimal? @db.Decimal(5, 2)
  grahamScore     Decimal? @db.Decimal(5, 2)
  bazinScore      Decimal? @db.Decimal(5, 2)
  finalScore      Decimal? @db.Decimal(5, 2)
  rank            Int?
  lastUpdated     DateTime @default(now()) @updatedAt
  dataSource      String?

  @@index([finalScore(sort: Desc)])
  @@index([rank])
  @@index([lastUpdated])
}

model FIIRanking {
  ticker         String   @id
  fundName       String?
  segment        String?
  financialData  Json
  dyScore        Decimal? @db.Decimal(5, 2)
  pvpScore       Decimal? @db.Decimal(5, 2)
  vacancyScore   Decimal? @db.Decimal(5, 2)
  debtScore      Decimal? @db.Decimal(5, 2)
  payoutScore    Decimal? @db.Decimal(5, 2)
  liquidityScore Decimal? @db.Decimal(5, 2)
  finalScore     Decimal? @db.Decimal(5, 2)
  rank           Int?
  lastUpdated    DateTime @default(now()) @updatedAt
  dataSource     String?

  @@index([finalScore(sort: Desc)])
  @@index([rank])
  @@index([lastUpdated])
}
